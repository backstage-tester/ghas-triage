# Which decision model to use: jev | laya   (or pass --backend jev,laya to compare)
TRIAGE_BACKEND=jev

# GitHub token: read access to code scanning, secret scanning, Dependabot alerts, contents
GITHUB_TOKEN=

# Jev (TypeSafe cloud)
TYPESAFE_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai

# Laya (self-hosted, TypeSafe-compatible API, e.g. laya2typesafeapi on port 8100)
LAYA_BASE_URL=http://localhost:8100
# LAYA_API_KEY=            # only if you set API_KEY on the Laya server

# Optional
# TRIAGE_MODEL=jev-latest
# TRIAGE_TIMEOUT=30
